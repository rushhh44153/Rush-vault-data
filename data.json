<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>RUSH 44153 | VAULT</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Tiro+Devanagari+Hindi:ital@0;1&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg: #050507;
            --surface: rgba(14, 14, 16, 0.95);
            --text: #f0ece4;
            --text-dim: #7a756d;
            --accent: #c9a227;
            --accent-light: #e6c35c;
            --accent-glow: rgba(201, 162, 39, 0.4);
            --border: rgba(201, 162, 39, 0.1);
            --whatsapp: #25D366;
            --twitter: #1DA1F2;
            --font-english: 'Cormorant Garamond', serif;
            --font-hindi: 'Tiro Devanagari Hindi', serif;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            background-color: var(--bg);
            color: var(--text);
            font-family: var(--font-hindi);
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-track { background: var(--bg); }
        ::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 10px; }

        .scroll-progress {
            position: fixed; top: 0; left: 0; height: 2px;
            background: linear-gradient(90deg, var(--accent), var(--accent-light));
            width: 0%; z-index: 10001;
        }

        .particles { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
        .particle {
            position: absolute; width: 2px; height: 2px;
            background: var(--accent); border-radius: 50%; opacity: 0;
            animation: floatUp 15s infinite;
        }
        @keyframes floatUp {
            0% { opacity: 0; transform: translateY(100vh) scale(0); }
            10% { opacity: 0.6; } 90% { opacity: 0.6; }
            100% { opacity: 0; transform: translateY(-100vh) scale(1); }
        }

        .cursor, .cursor-dot { display: none; }
        @media (hover: hover) and (pointer: fine) {
            * { cursor: none; }
            .cursor {
                display: block; width: 30px; height: 30px;
                border: 1.5px solid var(--accent); border-radius: 50%;
                position: fixed; pointer-events: none; z-index: 10000;
                transition: transform 0.2s ease, background 0.3s ease;
                transform: translate(-50%, -50%); mix-blend-mode: difference;
            }
            .cursor.hover { width: 60px; height: 60px; background: rgba(201, 162, 39, 0.15); border-color: transparent; }
            .cursor-dot {
                display: block; width: 6px; height: 6px; background: var(--accent);
                border-radius: 50%; position: fixed; pointer-events: none; z-index: 10001;
                transform: translate(-50%, -50%);
            }
        }

        .brand-watermark {
            position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
            font-family: var(--font-english); font-size: 20vw; font-weight: 200;
            color: transparent; -webkit-text-stroke: 2px rgba(201, 162, 39, 0.08);
            pointer-events: none; z-index: 0; letter-spacing: 15px;
            white-space: nowrap; user-select: none; opacity: 0;
            animation: watermarkIn 2s ease 2.5s forwards;
        }
        @keyframes watermarkIn { to { opacity: 1; } }

        body::before {
            content: ""; position: fixed; inset: 0;
            background: radial-gradient(ellipse at center, transparent 0%, rgba(0,0,0,0.85) 100%);
            pointer-events: none; z-index: 1;
        }
        body::after {
            content: ""; position: fixed; inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
            opacity: 0.03; pointer-events: none; z-index: 2;
        }

        .mesh-gradient {
            position: fixed; inset: 0; z-index: 0;
            background: 
                radial-gradient(ellipse at 20% 30%, rgba(201, 162, 39, 0.06) 0%, transparent 50%),
                radial-gradient(ellipse at 80% 70%, rgba(180, 140, 20, 0.04) 0%, transparent 50%);
            pointer-events: none; animation: meshPulse 20s ease-in-out infinite alternate;
        }
        @keyframes meshPulse { 0% { opacity: 0.5; transform: scale(1); } 100% { opacity: 0.7; transform: scale(1.03); } }

        /* ================= AUTH SCREEN ================= */
        .auth-screen {
            position: fixed; inset: 0; background: var(--bg); z-index: 300;
            display: flex; justify-content: center; align-items: center; text-align: center;
            transition: opacity 0.8s ease, visibility 0.8s;
        }
        .auth-screen.hidden { opacity: 0; visibility: hidden; pointer-events: none; }
        .auth-box {
            position: relative; z-index: 2; padding: 60px 50px;
            background: transparent; border: 1px solid rgba(201, 162, 39, 0.15);
            width: 100%; max-width: 400px; backdrop-filter: blur(10px);
            display: flex; flex-direction: column; gap: 20px;
        }
        .auth-title {
            font-family: var(--font-english); font-size: 2rem; color: var(--accent);
            letter-spacing: 8px; text-transform: uppercase; margin-bottom: 20px;
        }
        .auth-input {
            width: 100%; background: transparent; border: none; border-bottom: 1px solid rgba(201, 162, 39, 0.2);
            color: var(--text); font-family: var(--font-hindi); font-size: 1.1rem;
            padding: 12px 0; outline: none;
        }
        .auth-input:focus { border-color: var(--accent); }
        .auth-input::placeholder { color: var(--text-dim); }
        .auth-actions { display: flex; gap: 15px; margin-top: 10px; }
        .auth-btn {
            flex: 1; background: transparent; border: 1px solid rgba(201, 162, 39, 0.4); color: var(--accent);
            padding: 15px 20px; font-family: var(--font-english); font-size: 0.9rem;
            letter-spacing: 3px; text-transform: uppercase; cursor: pointer; transition: all 0.3s ease;
        }
        .auth-btn:hover { background: var(--accent); color: var(--bg); }
        .auth-hint { font-size: 0.8rem; color: var(--text-dim); margin-top: 10px; }

        /* ================= INTRO SCREEN ================= */
        #intro-screen {
            position: fixed; inset: 0; background: var(--bg); z-index: 100;
            display: flex; justify-content: center; align-items: center; text-align: center;
            transition: opacity 1.2s ease, visibility 1.2s;
        }
        #intro-screen.hidden { opacity: 0; visibility: hidden; pointer-events: none; }
        .intro-box {
            position: relative; z-index: 2; padding: 60px 50px;
            background: transparent; border: none; width: 100%; max-width: 600px;
        }
        .intro-line-top, .intro-line-bottom {
            position: absolute; left: 10%; width: 80%; height: 1px;
            background: linear-gradient(90deg, transparent, var(--accent), transparent);
            opacity: 0; animation: lineExpand 1s ease forwards;
        }
        .intro-line-top { top: 0; animation-delay: 0.2s; }
        .intro-line-bottom { bottom: 0; animation-delay: 0.2s; }
        @keyframes lineExpand { from { transform: scaleX(0); } to { transform: scaleX(1); opacity: 1; } }

        .brand-large {
            font-family: var(--font-english); font-size: clamp(4rem, 15vw, 8rem); font-weight: 200;
            letter-spacing: clamp(15px, 5vw, 50px); color: var(--accent); margin-bottom: 0;
            text-transform: uppercase; opacity: 0;
            animation: titleReveal 1.5s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards;
            position: relative; text-shadow: 0 0 80px rgba(201, 162, 39, 0.3);
        }
        .brand-large::before, .brand-large::after {
            content: 'RUSH'; position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0;
        }
        .brand-large::before { color: #ff0044; animation: glitch-1 5s infinite linear; }
        .brand-large::after { color: #00ddff; animation: glitch-2 5s infinite linear; }
        @keyframes glitch-1 { 0%, 100% { opacity: 0; transform: translate(0); } 8% { opacity: 0.5; transform: translate(-4px, 4px); } 9% { opacity: 0; } }
        @keyframes glitch-2 { 0%, 100% { opacity: 0; transform: translate(0); } 8% { opacity: 0.5; transform: translate(4px, -4px); } 9% { opacity: 0; } }

        .brand-sub { font-family: sans-serif; font-size: clamp(0.6rem, 2vw, 0.7rem); color: var(--text-dim); letter-spacing: clamp(8px, 2vw, 15px); margin: 12px 0 40px; opacity: 0; animation: fadeUp 1s ease 0.9s forwards; }
        .user-name { font-family: var(--font-hindi); font-size: clamp(1.8rem, 5vw, 2.8rem); color: var(--text); margin-bottom: 30px; opacity: 0; animation: fadeUp 1s ease 1.1s forwards; line-height: 1.4; }
        
        .hero-quote {
            font-family: var(--font-english); font-size: clamp(1.1rem, 3.5vw, 1.4rem);
            font-style: italic; color: rgba(240, 236, 228, 0.7); margin-bottom: 50px;
            max-width: 90%; margin-left: auto; margin-right: auto;
            line-height: 1.6; opacity: 0; animation: fadeUp 1s ease 1.2s forwards;
        }

        .enter-btn {
            background: transparent; border: 1px solid rgba(201, 162, 39, 0.4); color: var(--accent);
            padding: 20px 60px; font-family: var(--font-english); font-size: clamp(0.85rem, 2.5vw, 1rem);
            letter-spacing: 4px; text-transform: uppercase; cursor: pointer; transition: all 0.5s ease;
            opacity: 0; animation: fadeUp 1s ease 1.4s forwards;
        }
        .enter-btn:hover, .enter-btn:active { background: var(--accent); color: var(--bg); box-shadow: 0 0 60px rgba(201, 162, 39, 0.4); letter-spacing: 6px; }
        @keyframes fadeUp { from { opacity: 0; transform: translateY(25px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes titleReveal { from { opacity: 0; letter-spacing: 20vw; } to { opacity: 1; letter-spacing: clamp(15px, 5vw, 50px); } }

        /* ================= MAIN VAULT ================= */
        #main-vault { opacity: 0; transition: opacity 0.8s ease 0.2s; min-height: 100vh; position: relative; z-index: 10; }
        #main-vault.visible { opacity: 1; }

        .nav-header {
            position: fixed; top: 0; left: 0; right: 0; z-index: 50; padding: 20px 30px;
            display: flex; justify-content: space-between; align-items: center;
            background: linear-gradient(to bottom, rgba(5, 5, 7, 0.98) 0%, transparent 100%);
            backdrop-filter: blur(10px); opacity: 0; transform: translateY(-20px);
            transition: all 0.6s ease 0.6s;
        }
        .nav-header.visible { opacity: 1; transform: translateY(0); }
        .nav-brand { font-family: var(--font-english); font-size: clamp(1rem, 3vw, 1.2rem); letter-spacing: 6px; color: var(--accent); text-transform: uppercase; font-weight: 300; text-decoration: none; }

        .nav-actions { display: flex; align-items: center; gap: 20px; }
        .action-btn {
            background: none; border: none; color: var(--text-dim); cursor: pointer;
            transition: all 0.3s ease; display: flex; align-items: center; justify-content: center;
            padding: 8px;
        }
        .action-btn:hover { color: var(--accent); transform: translateY(-2px); }
        .action-btn svg { width: 20px; height: 20px; }

        .menu-btn { display: flex; flex-direction: column; gap: 5px; background: none; border: none; padding: 10px; cursor: pointer; }
        .menu-btn span { width: 25px; height: 1.5px; background: var(--accent); transition: all 0.3s ease; }
        .menu-btn.active span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
        .menu-btn.active span:nth-child(2) { opacity: 0; }
        .menu-btn.active span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }

        .nav-links {
            position: fixed; top: 70px; left: 0; right: 0;
            background: rgba(5, 5, 7, 0.98); backdrop-filter: blur(20px);
            display: flex; flex-direction: column; align-items: center; gap: 30px; padding: 40px 20px;
            transform: translateY(-150%); transition: transform 0.4s ease; z-index: 49;
        }
        .nav-links.open { transform: translateY(0); }
        .nav-link { font-family: var(--font-english); font-size: 1rem; color: var(--text-dim); text-decoration: none; letter-spacing: 3px; text-transform: uppercase; transition: all 0.4s ease; }
        .nav-link:hover, .nav-link:active { color: var(--accent); }

        .search-container {
            position: absolute; top: 100%; left: 0; right: 0;
            background: rgba(5, 5, 7, 0.98); padding: 20px;
            transform: scaleY(0); transform-origin: top; transition: transform 0.3s ease;
            z-index: 48;
        }
        .search-container.open { transform: scaleY(1); }
        .search-input {
            width: 100%; background: transparent; border: none; border-bottom: 1px solid var(--border);
            color: var(--text); font-family: var(--font-hindi); font-size: 1.1rem;
            padding: 10px 0; outline: none;
        }
        .search-input::placeholder { color: var(--text-dim); }

        @media (min-width: 769px) {
            .menu-btn { display: none; }
            .nav-links { position: static; flex-direction: row; background: transparent; padding: 0; transform: none; gap: 40px; }
            .nav-link { font-size: 0.75rem; position: relative; }
            .nav-link::after { content: ''; position: absolute; bottom: -5px; left: 0; width: 0; height: 1px; background: var(--accent); transition: width 0.3s ease; }
            .nav-link:hover::after { width: 100%; }
        }

        .vault-container { max-width: 850px; margin: 0 auto; padding: 140px 20px 60px; display: flex; flex-direction: column; gap: 60px; }
        @media (min-width: 769px) { .vault-container { padding: 160px 40px 80px; gap: 80px; } }

        .about-section { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 40px 0; position: relative; }
        .profile-frame { width: 150px; height: 150px; border-radius: 50%; position: relative; margin-bottom: 40px; opacity: 0; transform: scale(0.8); animation: profilePop 1s ease 0.3s forwards; }
        @media (min-width: 769px) { .profile-frame { width: 180px; height: 180px; margin-bottom: 50px; } }
        .profile-img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; filter: grayscale(50%) contrast(1.2); border: 2px solid rgba(201, 162, 39, 0.2); transition: all 0.5s ease; }
        .profile-frame:active .profile-img, .profile-frame:hover .profile-img { filter: grayscale(0%) contrast(1.05); border-color: var(--accent); }
        @keyframes profilePop { to { opacity: 1; transform: scale(1); } }
        .about-name { font-family: var(--font-hindi); font-size: clamp(2rem, 5vw, 2.8rem); color: var(--text); margin-bottom: 20px; opacity: 0; animation: fadeUp 1s ease 0.4s forwards; }
        .about-bio { max-width: 550px; font-size: clamp(1rem, 2.5vw, 1.15rem); line-height: 1.9; color: var(--text-dim); padding: 0 15px; opacity: 0; animation: fadeUp 1s ease 0.5s forwards; }
        .social-links { display: flex; gap: 15px; margin-top: 40px; opacity: 0; animation: fadeUp 1s ease 0.6s forwards; }
        .social-link { width: 44px; height: 44px; border: 1px solid var(--border); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--text-dim); transition: all 0.4s ease; text-decoration: none; }
        .social-link:hover, .social-link:active { border-color: var(--accent); color: var(--accent); transform: translateY(-3px); }
        .social-link svg { width: 18px; height: 18px; }

        .dedication-section { padding: 40px 20px; text-align: center; position: relative; opacity: 0; animation: fadeUp 1s ease 0.7s forwards; }
        @media (min-width: 769px) { .dedication-section { padding: 60px 40px; } }
        .dedication-card {
            position: relative; max-width: 750px; margin: 0 auto; min-height: 280px;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            padding: 50px 40px;
            background: linear-gradient(165deg, rgba(12, 12, 14, 0.98) 0%, rgba(5, 5, 7, 0.99) 100%);
            border: 1px solid rgba(201, 162, 39, 0.15);
            box-shadow: 0 0 60px -10px rgba(201, 162, 39, 0.15), inset 0 0 40px rgba(0, 0, 0, 0.5);
            overflow: hidden; animation: breathe 6s ease-in-out infinite;
        }
        @keyframes breathe { 0%, 100% { box-shadow: 0 0 60px -10px rgba(201, 162, 39, 0.15), inset 0 0 40px rgba(0, 0, 0, 0.5); } 50% { box-shadow: 0 0 80px -10px rgba(201, 162, 39, 0.25), inset 0 0 40px rgba(0, 0, 0, 0.5); } }
        .dedication-card::before { content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: radial-gradient(circle at center, rgba(201, 162, 39, 0.03) 0%, transparent 60%); pointer-events: none; z-index: 0; }
        .dedication-card::after { content: ''; position: absolute; inset: 10px; border: 1px solid rgba(201, 162, 39, 0.1); pointer-events: none; transition: all 0.4s ease; }
        .corner-decor { position: absolute; width: 20px; height: 20px; border-color: var(--accent); border-style: solid; z-index: 2; transition: all 0.4s ease; }
        .corner-tl { top: 0; left: 0; border-width: 2px 0 0 2px; } .corner-tr { top: 0; right: 0; border-width: 2px 2px 0 0; }
        .corner-bl { bottom: 0; left: 0; border-width: 0 0 2px 2px; } .corner-br { bottom: 0; right: 0; border-width: 0 2px 2px 0; }
        .dedication-card:hover .corner-decor { width: 30px; height: 30px; }
        .dedication-quote-icon { font-family: var(--font-english); font-size: 5rem; color: rgba(201, 162, 39, 0.1); line-height: 1; margin-bottom: 10px; position: relative; z-index: 1; }
        .dedication-text { font-family: var(--font-hindi); font-size: clamp(1.3rem, 3.5vw, 1.6rem); color: var(--text); line-height: 2.4; letter-spacing: 1px; position: relative; z-index: 1; text-shadow: 0 2px 10px rgba(0,0,0,0.5); max-width: 90%; }

        .section-title { text-align: center; margin-bottom: 30px; }
        .section-title h2 { font-family: var(--font-english); font-size: clamp(0.6rem, 2vw, 0.7rem); letter-spacing: 5px; color: var(--accent); text-transform: uppercase; font-weight: 400; }

        .cards-grid { display: flex; flex-direction: column; gap: 30px; }
        @media (min-width: 769px) { .cards-grid { gap: 40px; } }

        .card {
            background: var(--surface); border: 1px solid rgba(201, 162, 39, 0.05);
            padding: 35px 25px; text-align: center; position: relative; opacity: 0;
            transform: translateY(40px); transition: all 0.5s ease; backdrop-filter: blur(10px);
            display: none;
        }
        .card.visible { opacity: 1; transform: translateY(0) rotateX(0); display: block; }
        .card:hover, .card:active { transform: translateY(-5px); border-color: rgba(201, 162, 39, 0.2); box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4); }
        @media (hover: hover) { .card { transform: translateY(40px) perspective(1000px) rotateX(2deg); } .card:hover { transform: translateY(-8px) perspective(1000px) rotateX(0); } }
        .card-num { position: absolute; top: 15px; left: 20px; font-family: var(--font-english); color: rgba(201, 162, 39, 0.2); font-size: 0.65rem; letter-spacing: 2px; }
        .card-text { font-size: clamp(1.1rem, 3vw, 1.4rem); line-height: 2.2; color: var(--text); margin-bottom: 25px; position: relative; z-index: 1; }
        .card-divider { width: 40px; height: 1px; background: var(--accent); margin: 0 auto 15px; opacity: 0.4; }
        .card-footer { display: flex; justify-content: center; align-items: center; gap: 10px; flex-wrap: wrap; }
        .card-credit { font-family: var(--font-english); font-size: 0.65rem; color: var(--accent); letter-spacing: 2px; text-transform: uppercase; font-style: italic; margin-right: auto; }
        
        .card-btn { 
            background: transparent; border: 1px solid rgba(201, 162, 39, 0.15); color: var(--text-dim); 
            width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; 
            cursor: pointer; transition: all 0.3s ease; position: relative; 
        }
        .card-btn:hover, .card-btn:active { border-color: var(--accent); color: var(--bg); background: var(--accent); transform: scale(1.1); }
        .card-btn svg { width: 16px; height: 16px; }
        
        .card-btn.wa-btn:hover { background: var(--whatsapp); border-color: var(--whatsapp); }
        .card-btn.tw-btn:hover { background: var(--twitter); border-color: var(--twitter); }
        
        .like-count {
            position: absolute; top: -5px; right: -5px;
            background: #ff4757; color: white; font-size: 0.6rem;
            width: 18px; height: 18px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            opacity: 0; transform: scale(0);
            transition: all 0.3s ease;
        }
        .card-btn.heart-btn.active .like-count { opacity: 1; transform: scale(1); }
        .card-btn.heart-btn.active svg { fill: #ff4757; stroke: #ff4757; }

        .vault-footer { border-top: 1px solid var(--border); margin-top: 80px; padding: 60px 20px 40px; text-align: center; position: relative; }
        .footer-logo { font-family: var(--font-english); font-size: clamp(1.4rem, 4vw, 1.8rem); letter-spacing: 12px; color: var(--accent); text-transform: uppercase; font-weight: 200; margin-bottom: 15px; }
        .footer-quote { font-size: clamp(0.9rem, 2.5vw, 1rem); color: var(--text-dim); margin-top: 10px; margin-bottom: 30px; }
        .footer-since { font-family: var(--font-english); font-size: 0.75rem; color: var(--text-dim); letter-spacing: 3px; text-transform: uppercase; display: block; margin-bottom: 5px; }
        .footer-copyright { font-family: var(--font-english); font-size: 0.65rem; color: rgba(255,255,255,0.3); letter-spacing: 1px; margin-top: 25px; text-transform: uppercase; }

        .scroll-top { position: fixed; bottom: 25px; right: 25px; width: 50px; height: 50px; border: 1px solid var(--border); background: var(--surface); color: var(--accent); border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; opacity: 0; visibility: hidden; transition: all 0.4s ease; z-index: 100; }
        .scroll-top.visible { opacity: 1; visibility: visible; }
        .scroll-top:hover, .scroll-top:active { background: var(--accent); color: var(--bg); transform: translateY(-5px); }
        .toast { position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%) translateY(100px); background: var(--bg); border: 1px solid var(--accent); color: var(--accent); padding: 12px 25px; font-family: var(--font-english); font-size: 0.8rem; letter-spacing: 1px; z-index: 300; opacity: 0; transition: all 0.4s ease; border-radius: 2px; }
        .toast.show { transform: translateX(-50%) translateY(0); opacity: 1; }
    </style>
</head>
<body>

    <div class="scroll-progress" id="scrollProgress"></div>
    <div class="particles" id="particles"></div>
    <div class="cursor" id="cursor"></div>
    <div class="cursor-dot" id="cursorDot"></div>
    <div class="mesh-gradient"></div>
    <div class="brand-watermark">RUSH</div>

    <!-- AUTH SCREEN -->
    <div class="auth-screen" id="authScreen">
        <div class="auth-box">
            <div class="intro-line-top"></div>
            <div class="auth-title">Vault Access</div>
            <input type="email" class="auth-input" id="authEmail" placeholder="Email Address">
            <input type="password" class="auth-input" id="authPass" placeholder="Password">
            <div class="auth-actions">
                <button class="auth-btn" id="loginBtn">Login</button>
                <button class="auth-btn" id="signupBtn">Sign Up</button>
            </div>
            <p class="auth-hint">New users will receive a verification email.</p>
            <div class="intro-line-bottom"></div>
        </div>
    </div>

    <!-- INTRO SCREEN -->
    <div id="intro-screen" class="hidden">
        <div class="intro-box">
            <div class="intro-line-top"></div>
            <div class="brand-large">RUSH</div>
            <div class="brand-sub">44153</div>
            <div class="user-name" id="displayName"></div>
            <div class="hero-quote">"of all the ways to lose a person,<br>death is the kindest"</div>
            <button class="enter-btn" id="enterBtn">Verses Arena</button>
            <div class="intro-line-bottom"></div>
        </div>
    </div>

    <!-- MAIN VAULT -->
    <div id="main-vault">
        <nav class="nav-header" id="navHeader">
            <a href="#top" class="nav-brand">RUSH</a>
            
            <div class="nav-actions">
                <button class="action-btn" id="searchToggle" aria-label="Search">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                </button>
                <button class="action-btn" id="shuffleBtn" aria-label="Shuffle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/></svg>
                </button>
                <button class="action-btn" id="logoutBtn" aria-label="Logout" title="Logout" style="display: none;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                </button>
                <button class="menu-btn" id="menuBtn" aria-label="Menu"><span></span><span></span><span></span></button>
            </div>

            <div class="search-container" id="searchContainer">
                <input type="text" class="search-input" id="searchInput" placeholder="Search verses...">
            </div>

            <div class="nav-links" id="navLinks">
                <a href="#about" class="nav-link">about</a>
                <a href="#dedication" class="nav-link">dedication</a>
                <a href="#verses" class="nav-link">Verses</a>
                <a href="#connect" class="nav-link">Connect</a>
            </div>
        </nav>

        <div class="vault-container" id="top">
            
            <!-- ABOUT -->
            <section class="about-section" id="about">
                <div class="profile-frame"><img src="https://via.placeholder.com/150" alt="Profile" class="profile-img"></div>
                <h1 class="about-name" id="displayFullName"></h1>
                <p class="about-bio" id="displayBio"></p>
                <div class="social-links" id="connect">
                    <a href="#" class="social-link" id="instagramLink" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg></a>
                    <a href="#" class="social-link" id="twitterLink" aria-label="Twitter"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg></a>
                    <a href="#" class="social-link" id="emailLink" aria-label="Email"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></a>
                </div>
            </section>

            <!-- DEDICATION -->
            <section class="dedication-section" id="dedication">
                <div class="dedication-card">
                    <div class="corner-decor corner-tl"></div><div class="corner-decor corner-tr"></div>
                    <div class="corner-decor corner-bl"></div><div class="corner-decor corner-br"></div>
                    <div class="dedication-quote-icon">"</div>
                    <p class="dedication-text">वो हमारे जीवन से इस कदर गई मानो चस्म से नूर।</p>
                </div>
            </section>

            <!-- VERSES ARENA -->
            <section id="verses">
                <div class="section-title"><h2>Verses Arena</h2></div>
                <div class="cards-grid" id="vaultContainer"></div>
            </section>
            
            <!-- FOOTER -->
            <footer class="vault-footer">
                <div class="footer-logo">RUSH</div>
                <p class="footer-quote">"कुछ बातें अनकही ही बेहतर होती हैं।"</p>
                <span class="footer-since">EST. 44153</span>
                <div class="footer-copyright">&copy; RUSH VAULT. ALL RIGHTS RESERVED.</div>
            </footer>
        </div>
    </div>

    <button class="scroll-top" id="scrollTopBtn" aria-label="Scroll to top"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"/></svg></button>
    <div class="toast" id="toast">Copied to clipboard</div>

    <!-- FIREBASE SCRIPTS (Sirf Auth ke liye, Database nahi) -->
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-auth-compat.js"></script>
    
    <script>
        // ==========================================
        // FIREBASE AUTH CONFIG (Free Tier)
        // ==========================================
        const firebaseConfig = {
            apiKey: "YOUR_API_KEY",
            authDomain: "YOUR_PROJECT_ID.firebaseapp.com",
            projectId: "YOUR_PROJECT_ID",
            storageBucket: "YOUR_PROJECT_ID.appspot.com",
            messagingSenderId: "YOUR_SENDER_ID",
            appId: "YOUR_APP_ID"
        };

        firebase.initializeApp(firebaseConfig);
        const auth = firebase.auth();

        const authScreen = document.getElementById('authScreen');
        const introScreen = document.getElementById('intro-screen');
        const mainVault = document.getElementById('main-vault');
        const logoutBtn = document.getElementById('logoutBtn');
        const signupBtn = document.getElementById('signupBtn');
        const loginBtn = document.getElementById('loginBtn');

        signupBtn.addEventListener('click', () => {
            const email = document.getElementById('authEmail').value;
            const pass = document.getElementById('authPass').value;
            
            auth.createUserWithEmailAndPassword(email, pass)
                .then((userCredential) => {
                    userCredential.user.sendEmailVerification()
                        .then(() => showToast('Signup successful! Verification email sent.'))
                        .catch(err => showToast('Error sending email: ' + err.message));
                    auth.signOut();
                })
                .catch((error) => showToast(error.message));
        });

        loginBtn.addEventListener('click', () => {
            const email = document.getElementById('authEmail').value;
            const pass = document.getElementById('authPass').value;
            
            auth.signInWithEmailAndPassword(email, pass)
                .then((userCredential) => {
                    if (!userCredential.user.emailVerified) {
                        showToast('Please verify your email first!');
                        auth.signOut();
                    } else {
                        showToast('Login successful!');
                    }
                })
                .catch((error) => showToast(error.message));
        });

        logoutBtn.addEventListener('click', () => {
            auth.signOut().then(() => {
                showToast('Logged out successfully.');
                mainVault.classList.remove('visible');
                introScreen.classList.add('hidden');
                navHeader.classList.remove('visible');
                document.getElementById('vaultContainer').innerHTML = '';
            });
        });

        auth.onAuthStateChanged((user) => {
            if (user && user.emailVerified) {
                authScreen.classList.add('hidden');
                introScreen.classList.remove('hidden');
                logoutBtn.style.display = 'flex';
            } else {
                authScreen.classList.remove('hidden');
                introScreen.classList.add('hidden');
                mainVault.classList.remove('visible');
                logoutBtn.style.display = 'none';
            }
        });

        // ==========================================
        // FREE JSON DATABASE (GitHub Gist / Raw File)
        // YAHAN APNE GITHUB RAW JSON KI LINK DALEIN
        // ==========================================
        const DATA_URL = "https://raw.githubusercontent.com/USERNAME/REPO-NAME/main/data.json"; 

        let siteData = null; 

        async function loadData() {
            try {
                const response = await fetch(DATA_URL);
                siteData = await response.json();
                
                // Update UI with fetched data
                document.getElementById('displayName').innerText = siteData.name || "User";
                document.getElementById('displayFullName').innerText = siteData.fullName || "";
                document.getElementById('displayBio').innerText = siteData.bio || "";
                
                if (siteData.instagram) document.getElementById('instagramLink').href = `https://www.instagram.com/${siteData.instagram}`;
                if (siteData.twitter) document.getElementById('twitterLink').href = `https://twitter.com/${siteData.twitter}`;
                if (siteData.email) document.getElementById('emailLink').href = `mailto:${siteData.email}`;
                
            } catch (error) {
                console.error("Error fetching data:", error);
                showToast('Failed to load data.');
            }
        }

        // Call loadData when the page loads
        loadData();


        // ==========================================
        // UI & INTERACTIONS
        // ==========================================
        const particlesContainer = document.getElementById('particles');
        for(let i = 0; i < 20; i++) {
            const p = document.createElement('div'); p.className = 'particle';
            p.style.left = Math.random() * 100 + '%';
            p.style.animationDelay = Math.random() * 15 + 's';
            p.style.animationDuration = (15 + Math.random() * 10) + 's';
            particlesContainer.appendChild(p);
        }

        const cursor = document.getElementById('cursor'); const cursorDot = document.getElementById('cursorDot');
        let mouseX = 0, mouseY = 0, cursorX = 0, cursorY = 0;
        if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
            document.addEventListener('mousemove', (e) => { mouseX = e.clientX; mouseY = e.clientY; cursorDot.style.left = mouseX + 'px'; cursorDot.style.top = mouseY + 'px'; });
            function animateCursor() { cursorX += (mouseX - cursorX) * 0.1; cursorY += (mouseY - cursorY) * 0.1; cursor.style.left = cursorX + 'px'; cursor.style.top = cursorY + 'px'; requestAnimationFrame(animateCursor); }
            animateCursor();
            const addHover = (el) => { el.addEventListener('mouseenter', () => cursor.classList.add('hover')); el.addEventListener('mouseleave', () => cursor.classList.remove('hover')); };
            document.querySelectorAll('button, a, .card-btn, .dedication-card, .modal-close, .action-btn').forEach(addHover);
        }

        const navHeader = document.getElementById('navHeader');
        const enterBtn = document.getElementById('enterBtn'); const scrollTopBtn = document.getElementById('scrollTopBtn'); const toast = document.getElementById('toast'); const scrollProgress = document.getElementById('scrollProgress');
        const menuBtn = document.getElementById('menuBtn'); const navLinks = document.getElementById('navLinks');
        const searchToggle = document.getElementById('searchToggle');
        const searchContainer = document.getElementById('searchContainer');
        const searchInput = document.getElementById('searchInput');
        const shuffleBtn = document.getElementById('shuffleBtn');

        enterBtn.addEventListener('click', () => { 
            introScreen.classList.add('hidden'); 
            mainVault.classList.add('visible'); 
            setTimeout(() => navHeader.classList.add('visible'), 400); 
            renderVerses(); 
        });
        
        function showToast(msg) { 
            toast.textContent = msg; 
            toast.classList.add('show'); 
            setTimeout(() => toast.classList.remove('show'), 3500); 
        }

        menuBtn.addEventListener('click', () => { menuBtn.classList.toggle('active'); navLinks.classList.toggle('open'); });
        navLinks.querySelectorAll('.nav-link').forEach(link => { link.addEventListener('click', () => { menuBtn.classList.remove('active'); navLinks.classList.remove('open'); }); });

        searchToggle.addEventListener('click', () => {
            searchContainer.classList.toggle('open');
            if(searchContainer.classList.contains('open')) searchInput.focus();
        });

        searchInput.addEventListener('input', (e) => {
            const query = e.target.value.toLowerCase();
            document.querySelectorAll('.card').forEach(card => {
                const text = card.querySelector('.card-text').innerText.toLowerCase();
                if(text.includes(query)) {
                    card.style.display = 'block';
                    card.classList.add('visible');
                } else {
                    card.style.display = 'none';
                }
            });
        });

        shuffleBtn.addEventListener('click', () => {
            const cards = Array.from(document.querySelectorAll('.card'));
            const parent = document.getElementById('vaultContainer');
            for (let i = cards.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                parent.appendChild(cards[j]);
            }
            showToast('Verses Shuffled');
            document.querySelectorAll('.card').forEach((c, i) => {
                c.style.opacity = 0;
                c.style.transform = 'translateY(20px)';
                setTimeout(() => {
                    c.style.opacity = 1;
                    c.style.transform = 'translateY(0)';
                }, i * 50);
            });
        });

        function renderVerses() {
            if (!siteData || !siteData.verses) return;
            const vaultContainer = document.getElementById('vaultContainer');
            vaultContainer.innerHTML = '';

            siteData.verses.forEach((text, index) => {
                const card = document.createElement('div'); 
                card.className = 'card';
                const cardNum = String(index + 1).padStart(2, '0');
                
                card.innerHTML = `
                    <span class="card-num">${cardNum}</span>
                    <div class="card-text">${text}</div>
                    <div class="card-divider"></div>
                    <div class="card-footer">
                        <span class="card-credit">${siteData.creditText || 'by RUSH'}</span>
                        <button class="card-btn copy-btn" data-text="${text.replace(/"/g, '&quot;')}" aria-label="Copy"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button>
                        <button class="card-btn wa-btn" data-text="${text.replace(/"/g, '&quot;')}" aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg></button>
                        <button class="card-btn tw-btn" data-text="${text.replace(/"/g, '&quot;')}" aria-label="Twitter"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg></button>
                        <button class="card-btn heart-btn" aria-label="Like"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg><span class="like-count">1</span></button>
                    </div>
                `;
                vaultContainer.appendChild(card);
                setTimeout(() => { card.classList.add('visible'); }, 80 * index);
            });

            attachCardEvents(document.body);
        }

        function attachCardEvents(container) {
            container.querySelectorAll('.copy-btn').forEach(btn => {
                btn.addEventListener('click', async () => {
                    try { await navigator.clipboard.writeText(btn.dataset.text); showToast('Verse copied!'); } catch (e) { showToast('Failed to copy'); }
                });
            });
            container.querySelectorAll('.wa-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const url = `https://api.whatsapp.com/send?text=${encodeURIComponent(btn.dataset.text)}`;
                    window.open(url, '_blank');
                });
            });
            container.querySelectorAll('.tw-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const url = `https://twitter.com/intent/tweet?text=${encodeURIComponent(btn.dataset.text)}`;
                    window.open(url, '_blank');
                });
            });
            container.querySelectorAll('.heart-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    btn.classList.toggle('active');
                    const counter = btn.querySelector('.like-count');
                    if(btn.classList.contains('active')) {
                        counter.innerText = "1";
                        showToast('Added to favorites');
                    } else {
                        counter.innerText = "";
                    }
                });
            });
        }

        window.addEventListener('scroll', () => {
            const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
            const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            scrollProgress.style.width = (winScroll / height) * 100 + '%';
            if (winScroll > 300) scrollTopBtn.classList.add('visible'); else scrollTopBtn.classList.remove('visible');
        });
        scrollTopBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    </script>
</body>
</html>
